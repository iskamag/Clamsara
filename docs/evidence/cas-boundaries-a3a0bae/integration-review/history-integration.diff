+                      (clamsara::runtime-rejection () :blocked)
+                      (clamsara::construction-rejected () :blocked))))
+             (format t "~&FATAL-UNBIND-SHUTDOWN outcome=~S unbind=~S shutdown=~S release-index=~D->~D~%"
+                     outcome unbound shutdown release-index
+                     (clamsara::%configuration-shutdown-release-index configuration))
+             (check (member outcome '(:post-publication-failure :fatal-invariant)) "Fatal escape absent")
+             (check (member unbound '(:unbound :retry)) "Unexpected fatal-world unbind result")
+             (check (eq shutdown :blocked) "Fatal shutdown released rooted world after unbind")
+             (check (= release-index (clamsara::%configuration-shutdown-release-index configuration))
+                    "Fatal shutdown advanced resource release")
+             (check (not (eq (clamsara::%configuration-state configuration) :complete))
