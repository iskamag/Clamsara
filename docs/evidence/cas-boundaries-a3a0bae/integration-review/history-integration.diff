+          (*construction-observation* (make-construction-observation)))
+      (handler-case
+          (progn
+            (handler-case (setf w (make-review-world))
+              (clamsara::construction-rejected (condition)
+                (setf rejected t
+                      rejection-reason (clamsara::construction-rejection-reason condition))))
+            (check rejected "Ambiguous dual READ+CAS contribution was published")
+            (check (and rejection-reason (symbolp rejection-reason))
