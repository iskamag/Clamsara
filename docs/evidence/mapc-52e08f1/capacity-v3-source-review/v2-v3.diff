+(defun cap-observer-self-check ()
+  "Synthetic observer check. Creates no runtime and touches no real descriptor."
+  (let ((marker (gensym "CAP-SOURCE-MARKER-"))
+        (source (cons :payload nil))
+        (index (cons :symbol :indicator)))
+    (labels ((sample (s i)
+               ;; Same representation shape as CAP-STATE, but synthetic only.
+               (list (list marker s) (list i)
+                     (list (list :property s i)))))
+      (let* ((before (sample source index))
+             (same (sample source index))
+             (other-source (sample (copy-list source) index))
+             (other-index (sample source (cons (car index) (cdr index)))))
+        (assert (cap-unchanged-p before same))
+        ;; The prior structural descriptor oracle would accept these details.
+        (assert (equal (third before) (third other-source)))
+        (assert (equal (third before) (third other-index)))
+        (assert (not (cap-unchanged-p before other-source)))
+        (assert (not (cap-unchanged-p before other-index))))
+      (let ((a (+ most-positive-fixnum 19))
+            (b (+ most-positive-fixnum 19)))
+        (assert (eql a b))
+        (assert (cap-unchanged-p (sample source a) (sample source b))))))
+  t)
+
+(defun cap-check-recovery-list (o expected)
+  (let* ((values (maclina.vm-cross::vm-values (cap-vm o)))
+         (cursor (first values))
+         (seen (make-hash-table :test #'eq)))
+    (assert (= 1 (length values)))
+    (dolist (element expected)
+      (assert (workload-reference-p (cap-env o) cursor))
+      (assert (not (gethash cursor seen)))
+      (setf (gethash cursor seen) t)
+      (assert (= element (workload-read-slot (cap-env o) cursor :car)))
+      (setf cursor (workload-read-slot (cap-env o) cursor :cdr)))
+    (assert (null cursor))
+    (assert (= (length expected) (hash-table-count seen)))))
+
+(defun cap-run-smaller-nonempty-recovery ()
+  "A four-cell arena rejects two lists, then really executes one nonempty list."
+  (cap-with-fixture-methods
+   (lambda ()
+     (let ((o (cap-new '(:roots 4096 :cells 4 :frames 128 :stack 1024))))
+       (cap-guard o
+        (lambda ()
+          (cap-prepare o)
+          (cap-note o :two-list-rejection-on-four-cells)
+          (cap-expect-rejection o
+           (lambda ()
+             (let ((inputs (maclina.vm-cross::vm-values (cap-vm o))))
+               (funcall (cap-fn o 'cl:mapc) (cap-fn o 'cap-callback)
+                        (first inputs) (second inputs))))
+           :native-cell-capacity-exhausted)
+          (assert (zerop (cap-owner-calls o)))
+          (assert (zerop (clamsara::workload-provider-native-cell-count
+                          (cap-owner-provider o))))
+          ;; The expected rejection is proved before the application replaces
+          ;; its prior result or installs another case-owned callback.
+          (cap-fset o 'cap-one
+            (workload-eval (cap-env o)
+              '(let ((capture (cons 5 nil)))
+                 (lambda (x)
+                   (cap-entry-witness)
+                   (cap-record-row (+ x (car capture)))))))
+          (cap-note o :smaller-nonempty-one-list-recovery)
+          (let ((*cap-active* o) (*cap-entry-witness-enabled* t))
+            (workload-eval (cap-env o)
+              '(funcall #'mapc #'cap-one (cons 11 (cons 13 nil)))))
+          ;; One list needs three cells, not the rejected two-list five cells.
+          (assert (= 4 (length (clamsara::workload-provider-native-cells
+                                (cap-owner-provider o)))))
+          (assert (= 2 (cap-owner-calls o)))
+          (assert (= 34 (cap-owner-sum o)))
+          (assert (= 2 (cap-owner-moving-cycles o)))
+          (assert (zerop (clamsara::workload-provider-native-cell-count
+                          (cap-owner-provider o))))
+          (assert (zerop (clamsara::workload-provider-frame-count
+                          (cap-owner-provider o))))
+          (cap-check-recovery-list o '(11 13))
+          (cap-finish o)))))))
+
+(defun cap-run-post-outer-nonempty-recovery ()
+  (cap-with-fixture-methods
+   (lambda ()
+     (let ((o (cap-new '(:roots 4096 :cells 5 :frames 128 :stack 1024))))
+       (cap-guard o
+        (lambda ()
+          (cap-prepare o)
+          (cap-fset o 'cap-inner-attempt #'cap-inner-attempt)
+          (cap-fset o 'cap-inner
+            (workload-eval (cap-env o)
+              '(lambda (x y) (declare (ignore x y))
+                 (error 'cap-unexpected-callback))))
+          (cap-fset o 'cap-outer
+            (workload-eval (cap-env o)
+              '(let ((capture (cons 7 nil)))
+                 (lambda (x y)
+                   (cap-inner-attempt)
+                   ;; All payload reads happen AFTER inner rejection and GC.
+                   (cap-record-row (+ (car x) (car y) (car capture)))))))
+          (cap-note o :nested-inner-rejection-outer-movement)
+          (let ((*cap-active* o))
+            (workload-eval (cap-env o)
+              '(funcall #'mapc #'cap-outer
+                 (cons (cons 1 nil) (cons (cons 2 nil) nil))
+                 (cons (cons 10 nil) (cons (cons 20 nil) nil)))))
+          (assert (= 2 (cap-owner-inner-rejections o)))
+          (assert (= 2 (cap-owner-calls o)))
+          (assert (= 47 (cap-owner-sum o)))
+          (assert (= 2 (cap-owner-moving-cycles o)))
+          (assert (zerop (clamsara::workload-provider-native-cell-count
+                          (cap-owner-provider o))))
+          (assert (zerop (clamsara::workload-provider-frame-count
+                          (cap-owner-provider o))))
+          (let* ((result (first (maclina.vm-cross::vm-values (cap-vm o))))
+                 (second (workload-read-slot (cap-env o) result :cdr)))
+            (assert (= 1 (workload-read-slot (cap-env o)
+                           (workload-read-slot (cap-env o) result :car) :car)))
+            (assert (= 2 (workload-read-slot (cap-env o)
+                           (workload-read-slot (cap-env o) second :car) :car)))
+            (assert (null (workload-read-slot (cap-env o) second :cdr))))
+          ;; The original outer result has been proved. Its native extent has
+          ;; released before this new, nonempty call requests the same 5 cells.
+          (cap-note o :outer-extent-released)
+          (assert (= 5 (length (clamsara::workload-provider-native-cells
+                                (cap-owner-provider o)))))
+          (assert (zerop (clamsara::workload-provider-native-cell-count
+                          (cap-owner-provider o))))
+          (cap-note o :nonempty-two-list-after-outer-release)
+          (let ((*cap-active* o) (*cap-entry-witness-enabled* t))
+            (workload-eval (cap-env o)
+              '(funcall #'mapc #'cap-callback (cons 11 nil) (cons 13 nil))))
+          (assert (= 2 (cap-owner-inner-rejections o)))
+          (assert (= 3 (cap-owner-calls o)))
+          (assert (= 112 (cap-owner-sum o))) ; 47 from outer + 65 from recovery
+          (assert (= 3 (cap-owner-moving-cycles o)))
+          (assert (zerop (clamsara::workload-provider-native-cell-count
+                          (cap-owner-provider o))))
+          (assert (zerop (clamsara::workload-provider-frame-count
+                          (cap-owner-provider o))))
+          (cap-check-recovery-list o '(11))
+          (cap-finish o)))))))
+
