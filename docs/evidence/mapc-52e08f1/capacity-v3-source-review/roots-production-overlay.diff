+(defun %make-workload-native-cells (capacity)
+  ;; These are interpreter control sources, never boxed guest list payload.
+  (let ((cells (make-array capacity)))
+    (dotimes (i capacity cells) (setf (aref cells i) (cons nil nil)))))
