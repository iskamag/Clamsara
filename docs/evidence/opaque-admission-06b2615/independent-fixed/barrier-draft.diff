+(defun %barrier-primary-candidate-p (generic actual event-position event)
+  #-sbcl (declare (ignore generic actual event-position event))
+  ;; Ordinary construction only. There is no portable wildcard-valued CLOS
+  ;; applicability query. Inspect known inputs without fabricating values for
+  ;; the reservation, context, location or payload positions. Nothing here
+  ;; executes an author method or retains a method registry in the barrier.
+  #+sbcl
+  (progn
+    ;; The protocol declares STANDARD combination. Do not silently interpret
+    ;; qualifiers from a different combination using its primary-method rule.
+    (unless (eq (sb-mop:generic-function-method-combination generic)
+                (sb-mop:find-method-combination generic 'standard nil))
+      (%runtime-reject :unsupported-barrier-method-combination))
+    (flet ((matches (specializer value)
+             (typecase specializer
+               (sb-mop:eql-specializer
+                (eql value (sb-mop:eql-specializer-object specializer)))
+               (class (typep value specializer))
+               (t (%runtime-reject :unsupported-barrier-method-specializer)))))
+      (some (lambda (method)
+              (and (null (method-qualifiers method))
+                   (let ((specializers (sb-mop:method-specializers method)))
+                     (and (matches (first specializers) actual)
+                          (or (null event-position)
+                              (matches (nth event-position specializers)
+                                       event))))))
+            (sb-mop:generic-function-methods generic))))
+  #-sbcl (%runtime-reject :unsupported-barrier-method-admission))
 
