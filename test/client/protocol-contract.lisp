;;;; test/client/protocol-contract.lisp
;;;; Native SBCL contract checks for the paper-v14 client protocol declarations.
;;;; These tests use isolated mocks only to check callback shape, raw CAS
;;;; encoding, and root snapshot lifetimes.  They do not pretend to provide a
;;;; target integration or a collector implementation.

(defpackage #:clamsara.client.test
  (:use #:cl #:clamsara)
  (:export #:run-v14-client-contracts))

(in-package #:clamsara.client.test)

(defun %fail (format-control &rest args)
  (error "v14 client contract failure: ~?" format-control args))

(defun %lambda-token (thing)
  (cond ((symbolp thing) (string-upcase (symbol-name thing)))
        ((consp thing) (cons (%lambda-token (car thing))
                             (%lambda-token (cdr thing))))
        (t thing)))

(defun %assert-lambda-list (name expected)
  #+sbcl
  (let* ((gf (symbol-function name))
         (actual (sb-mop:generic-function-lambda-list gf)))
    (unless (equal (%lambda-token actual) (%lambda-token expected))
      (%fail "~s lambda list ~s, expected ~s" name actual expected)))
  #-sbcl
  (declare (ignore name expected)))

