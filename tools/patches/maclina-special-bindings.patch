diff --git a/test/ansi/special.lisp b/test/ansi/special.lisp
--- a/test/ansi/special.lisp
+++ b/test/ansi/special.lisp
@@ -34,3 +34,103 @@
       (%f)))
   a)
 
+
+;;; Global proclamations survive lexical carrier slots and local declarations.
+(defvar *globally-special-test* 0)
+
+(deftest special.global-required-setq
+  (flet ((read-current () *globally-special-test*))
+    ((lambda (*globally-special-test*)
+       (setq *globally-special-test* (1+ *globally-special-test*))
+       (values *globally-special-test* (read-current)))
+     17))
+  18 18)
+
+(deftest special.global-required-rebind
+  (flet ((read-current () *globally-special-test*))
+    ((lambda (*globally-special-test*)
+       (declare (special *globally-special-test*))
+       (let ((*globally-special-test* 99)) (read-current)))
+     17))
+  99)
+
+(deftest special.global-optional-default
+  (flet ((read-current () *globally-special-test*))
+    ((lambda (*globally-special-test*
+              &optional (x (progn
+                             (setq *globally-special-test*
+                                   (1+ *globally-special-test*))
+                             (read-current))))
+       (values *globally-special-test* x (read-current)))
+     17))
+  18 18 18)
+
+(deftest special.global-key-default
+  (flet ((read-current () *globally-special-test*))
+    ((lambda (*globally-special-test*
+              &key (x (progn
+                        (setq *globally-special-test*
+                              (1+ *globally-special-test*))
+                        (read-current))))
+       (values *globally-special-test* x (read-current)))
+     17))
+  18 18 18)
+
+(deftest special.global-aux-default
+  (flet ((read-current () *globally-special-test*))
+    ((lambda (*globally-special-test*
+              &aux (x (progn
+                        (setq *globally-special-test*
+                              (1+ *globally-special-test*))
+                        (read-current))))
+       (values *globally-special-test* x (read-current)))
+     17))
+  18 18 18)
+
+(deftest special.global-declared-optional
+  (locally (declare (special *globally-special-test*))
+    (flet ((read-current () *globally-special-test*))
+      ((lambda (&optional (*globally-special-test* 17))
+         (setq *globally-special-test* (1+ *globally-special-test*))
+         (values *globally-special-test* (read-current))))))
+  18 18)
+
+(deftest special.global-declared-key
+  (locally (declare (special *globally-special-test*))
+    (flet ((read-current () *globally-special-test*))
+      ((lambda (&key (*globally-special-test* 17))
+         (setq *globally-special-test* (1+ *globally-special-test*))
+         (values *globally-special-test* (read-current))))))
+  18 18)
+
+(deftest special.global-declared-aux
+  (locally (declare (special *globally-special-test*))
+    (flet ((read-current () *globally-special-test*))
+      ((lambda (&aux (*globally-special-test* 17))
+         (setq *globally-special-test* (1+ *globally-special-test*))
+         (values *globally-special-test* (read-current))))))
+  18 18)
+
+(deftest special.global-callee-writes
+  (flet ((write-current (x) (setq *globally-special-test* x)))
+    ((lambda (*globally-special-test*)
+       (write-current 37)
+       *globally-special-test*)
+     17))
+  37)
+
+(deftest special.global-escaped-reader
+  (let ((reader ((lambda (*globally-special-test*)
+                   #'(lambda () *globally-special-test*))
+                 17)))
+    (let ((*globally-special-test* 88)) (funcall reader)))
+  88)
+
+(deftest special.global-restoration
+  (let ((*globally-special-test* 9))
+    (values ((lambda (*globally-special-test*)
+               (setq *globally-special-test* (1+ *globally-special-test*))
+               *globally-special-test*)
+             17)
+            *globally-special-test*))
+  18 9)
