diff --git a/compile/compile.lisp b/compile/compile.lisp
--- a/compile/compile.lisp
+++ b/compile/compile.lisp
@@ -1789,7 +1789,16 @@
             (push-map-info (make-instance 'm:vars-info
                              :start start :end end :bindings igninfos)
                            context)))
-        (setq new-env (add-specials (intersection specials required) new-env)))
+        ;; Required arguments initially occupy lexical carrier slots. Hide
+        ;; those carriers from body/default compilation for every special
+        ;; parameter, including globally proclaimed ones.
+        (setq new-env
+              (add-specials
+               (remove-if-not (lambda (var)
+                                (or (member var specials)
+                                    (globally-special-p var env)))
+                              required)
+               new-env)))
       (unless (zerop optional-count)
         (assemble context m:bind-optional-args min-count optional-count)
         (loop for (opt default -p) in optionals
